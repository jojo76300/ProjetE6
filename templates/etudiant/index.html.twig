{% extends 'base.html.twig' %}

{% block title %}Gestion des étudiants{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        body { 
            background-color: #f9fafb;
            margin: 0;
            font-family: 'Inter', sans-serif;
            color: #111827;
            font-size: 14px; /* Réduction globale de la taille de police (moins zoomé) */
        }

        /* --- HEADER --- */
        .app-header {
            background-color: #ffffff;
            border-bottom: 1px solid #e5e7eb;
            height: 65px; /* Légèrement moins haut */
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 40px;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 20px;
            height: 100%;
        }
        
        /* Correction du logo : on force une taille petite et on masque ce qui dépasse */
        .header-logo {
            height: 35px;
            width: auto;
            max-width: 150px;
            object-fit: contain;
            mix-blend-mode: multiply; /* Astuce pour effacer le fond blanc d'une image jpeg/png */
        }

        .header-left h1 {
            margin: 0;
            font-size: 18px; /* Plus petit */
            font-weight: 600;
        }

        .header-right {
            display: flex;
            align-items: center;
            gap: 25px;
        }

        .user-role {
            color: #6b7280;
        }

        .btn-logout {
            color: #111827;
            text-decoration: none;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .btn-logout:hover { color: #4b5563; }

        /* --- LAYOUT PRINCIPAL --- */
        .app-layout {
            display: flex;
            min-height: calc(100vh - 65px);
        }

        /* --- SIDEBAR --- */
        .sidebar {
            width: 240px; /* Légèrement moins large */
            background-color: #ffffff;
            border-right: 1px solid #e5e7eb;
            padding: 25px 15px;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 15px; /* Moins de padding */
            color: #4b5563;
            text-decoration: none;
            font-weight: 500;
            border-radius: 8px;
            transition: all 0.2s;
        }

        .nav-item:hover { background-color: #f3f4f6; }

        .nav-item.active {
            background-color: #eff6ff;
            color: #2563eb;
        }
        
        .nav-item i {
            width: 20px;
            text-align: center;
            font-size: 16px; /* Icônes plus petites */
        }

        /* --- CONTENU --- */
        .main-content {
            flex-grow: 1;
            padding: 40px;
            display: flex;
            justify-content: center; /* Centre le contenu si l'écran est très grand */
        }
        
        .content-wrapper {
            width: 100%;
            max-width: 1100px; /* Limite la largeur max pour un affichage optimal (pas trop étiré) */
        }

        .page-title {
            font-size: 24px; /* Plus petit */
            font-weight: 700;
            margin: 0 0 5px 0;
            color: #111827;
        }

        .page-subtitle {
            color: #6b7280;
            margin: 0 0 35px 0;
        }

        /* --- BARRE D'ACTIONS --- */
        .action-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        .search-container {
            position: relative;
            width: 350px; /* Moins large */
        }

        .search-container i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #9ca3af;
        }

        .search-input {
            width: 100%;
            padding: 9px 15px 9px 40px;
            background-color: #f3f4f6;
            border: none;
            border-radius: 8px;
            font-size: 13px;
            color: #111827;
            outline: none;
        }

        .btn-add {
            background-color: #0f172a;
            color: white;
            border: none;
            padding: 9px 18px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .btn-add:hover { background-color: #1e293b; color: white; }

        /* --- TABLEAU --- */
        .table-container {
            background-color: #ffffff;
            border-radius: 12px;
            border: 1px solid #e5e7eb;
            overflow: hidden;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            background-color: #ffffff;
            text-align: left;
            padding: 14px 20px;
            font-size: 12px;
            text-transform: uppercase; /* Met les titres de colonnes en majuscules comme les standards modernes */
            letter-spacing: 0.05em;
            font-weight: 600;
            color: #6b7280;
            border-bottom: 1px solid #e5e7eb;
        }

        td {
            padding: 14px 20px;
            color: #374151;
            border-bottom: 1px solid #e5e7eb;
            vertical-align: middle;
        }
        
        tr:last-child td { border-bottom: none; }

        .col-nom {
            font-weight: 600;
            color: #111827;
        }

        /* --- BADGES --- */
        .badge {
            padding: 4px 10px;
            border-radius: 9999px;
            font-size: 11px;
            font-weight: 600;
            display: inline-block;
        }
        .badge-slam {
            background-color: #e0e7ff;
            color: #3b82f6;
        }
        .badge-sisr {
            background-color: #d1fae5;
            color: #10b981;
        }

        .actions-cell {
            text-align: right;
            white-space: nowrap;
        }
        
        .btn-icon {
            background: none;
            border: none;
            cursor: pointer;
            padding: 5px;
            font-size: 14px; /* Icônes plus petites */
        }
        
        .icon-edit {
            color: #2563eb;
            text-decoration: none;
            margin-right: 15px;
        }
        
        .icon-delete { color: #ef4444; }
        .d-inline { display: inline-block; }
    </style>
{% endblock %}

{% block body %}
<!-- HEADER -->
<div class="app-header">
    <div class="header-left">
        <!-- Correction du logo appliquée ici -->
        <img src="C:\Users\jorda\ProjetE6-1\images\logo.png" alt="Logo" class="header-logo">
        <h1>Suivi des stages</h1>
    </div>
    <div class="header-right">
        <span class="user-role">
            {% if is_granted('ROLE_ADMIN') %}
                Administrateur
            {% elseif is_granted('ROLE_TEACHER') %}
                Enseignant
            {% else %}
                Utilisateur
            {% endif %}
        </span>

        <a href="{{ path('app_logout') }}" class="btn-logout">
            <i class="fas fa-sign-out-alt"></i> Déconnexion
        </a>
    </div>
</div>

<div class="app-layout">
    <!-- SIDEBAR -->
    <div class="sidebar">
        <a href="#" class="nav-item"><i class="fas fa-th-large"></i> Dashboard</a>
        <a href="{{ path('app_etudiant_index') }}" class="nav-item active"><i class="fas fa-user-graduate"></i> Étudiants</a>
        <a href="#" class="nav-item"><i class="fas fa-building"></i> Entreprises</a>
        <a href="#" class="nav-item"><i class="fas fa-briefcase"></i> Stages</a>
        <a href="#" class="nav-item"><i class="fas fa-clipboard-check"></i> Suivi & visites</a>
        <a href="#" class="nav-item"><i class="fas fa-download"></i> Exports</a>
    </div>

    <!-- MAIN CONTENT -->
    <div class="main-content">
        <!-- Wrappeur pour limiter la largeur et centrer le contenu sur les très grands écrans -->
        <div class="content-wrapper">
            <h2 class="page-title">Gestion des étudiants</h2>
            <p class="page-subtitle">Gérez les étudiants de la formation BTS SIO</p>

            <div class="action-bar">
                <div class="search-container">
                    <i class="fas fa-search"></i>
                    <input type="text" class="search-input" placeholder="Rechercher un étudiant...">
                </div>
                
                <a href="{{ path('app_etudiant_new') }}" class="btn-add">
                    <i class="fas fa-plus"></i> Ajouter un étudiant
                </a>
            </div>

            <!-- TABLEAU -->
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Nom</th>
                            <th>Prénom</th>
                            <th>Filière</th>
                            <th>Promotion</th>
                            <th style="text-align: right;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for etudiant in etudiants %}
                        {% if not etudiant.isArchived %}
                        <tr>
                            <td class="col-nom">{{ etudiant.nom }}</td>
                            <td>{{ etudiant.prenom }}</td>
                            <td>
                                {% if etudiant.filiere == 'SLAM' %}
                                    <span class="badge badge-slam">SLAM</span>
                                {% else %}
                                    <span class="badge badge-sisr">SISR</span>
                                {% endif %}
                            </td>
                            <td>{{ etudiant.annPromotion }}</td>
                            <td class="actions-cell">
                                <a href="{{ path('app_etudiant_edit', {'id': etudiant.id}) }}" class="btn-icon icon-edit">
                                    <i class="fas fa-pen"></i>
                                </a>
                                
                                <form method="post" action="{{ path('app_etudiant_delete', {'id': etudiant.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir archiver cet étudiant ?');" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ etudiant.id) }}">
                                    <button type="submit" class="btn-icon icon-delete"><i class="fas fa-trash-alt"></i></button>
                                </form>
                            </td>
                        </tr>
                        {% endif %}
                    {% else %}
                        <tr>
                            <td colspan="5" style="text-align: center; padding: 40px; color: #6b7280;">
                                Aucun étudiant trouvé.
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
