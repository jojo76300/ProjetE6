{{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
    <div class="space-y-4">
        {% if form.nom is defined %}
            <div>
                {{ form_label(form.nom, "Nom*", {'label_attr': {'class': 'block text-sm font-semibold text-gray-900 uppercase tracking-wider mb-2'}}) }}
                {{ form_widget(form.nom, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:border-transparent', 'id': 'stage_nom'}}) }}
                {% if form.nom.vars.errors|length > 0 %}
                    <div class="text-red-600 text-sm mt-1 flex items-center gap-1">
                        <i class="fas fa-exclamation-circle"></i>{{ form_errors(form.nom) }}
                    </div>
                {% endif %}
            </div>
        {% endif %}

        {% if form.prenom is defined %}
            <div>
                {{ form_label(form.prenom, "Prénom*", {'label_attr': {'class': 'block text-sm font-semibold text-gray-900 uppercase tracking-wider mb-2'}}) }}
                {{ form_widget(form.prenom, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:border-transparent', 'id': 'stage_prenom'}}) }}
                {% if form.prenom.vars.errors|length > 0 %}
                    <div class="text-red-600 text-sm mt-1 flex items-center gap-1">
                        <i class="fas fa-exclamation-circle"></i>{{ form_errors(form.prenom) }}
                    </div>
                {% endif %}
            </div>
        {% endif %}

        {% if form.filiere is defined %}
            <div>
                {{ form_label(form.filiere, "Filière*", {'label_attr': {'class': 'block text-sm font-semibold text-gray-900 uppercase tracking-wider mb-2'}}) }}
                {{ form_widget(form.filiere, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:border-transparent', 'id': 'stage_filiere'}}) }}
                {% if form.filiere.vars.errors|length > 0 %}
                    <div class="text-red-600 text-sm mt-1 flex items-center gap-1">
                        <i class="fas fa-exclamation-circle"></i>{{ form_errors(form.filiere) }}
                    </div>
                {% endif %}
            </div>
        {% endif %}

        {% if form.annPromotion is defined %}
            <div>
                {{ form_label(form.annPromotion, "Année de promotion", {'label_attr': {'class': 'block text-sm font-semibold text-gray-900 uppercase tracking-wider mb-2'}}) }}
                {{ form_widget(form.annPromotion, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:border-transparent', 'id': 'stage_annPromotion'}}) }}
                {% if form.annPromotion.vars.errors|length > 0 %}
                    <div class="text-red-600 text-sm mt-1 flex items-center gap-1">
                        <i class="fas fa-exclamation-circle"></i>{{ form_errors(form.annPromotion) }}
                    </div>
                {% endif %}
            </div>
        {% endif %}
    </div>

    <div class="flex gap-3 pt-6 border-t border-gray-200">
        <button type="submit" class="flex-1 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-4 rounded-lg transition-colors duration-200 flex items-center justify-center gap-2">
            <i class="fas fa-save"></i>{{ button_label|default('Enregistrer') }}
        </button>
        <a href="{{ path('app_stage_index') }}" class="flex-1 bg-gray-600 hover:bg-gray-700 text-white font-semibold py-3 px-4 rounded-lg transition-colors duration-200 text-center flex items-center justify-center gap-2">
            <i class="fas fa-times"></i>Annuler
        </a>
    </div>

{{ form_end(form) }}