{% extends 'base.html.twig' %}

{% block title %}Test Menu{% endblock %}

{% block body %}
<style>
    .menu-test-layout {
        display: flex;
        min-height: 100vh;
        background: #f5f7fb;
    }

    .menu-test-content {
        flex: 1;
        padding: 24px;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
        color: #0f172a;
    }

    .menu-test-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 20px;
        max-width: 720px;
    }

    .menu-test-card h1 {
        margin-top: 0;
    }
</style>

<div class="menu-test-layout">
    {{ include('menu.html.twig') }}

    <main class="menu-test-content">
        <div class="menu-test-card">
            <h1>Page de test du menu</h1>
            <p>Route de test: <strong>/menu-test</strong></p>
        </div>
    </main>
</div>
{% endblock %}
