{% extends 'base.html.twig' %}

{% block title %}Historique des Changements{% endblock %}

{% block body %}
    <h1>Historique des Changements</h1>

    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>ID Entreprise</th>
                <th>ID Etudiant</th>
                <th>ID Stage</th>
            </tr>
        </thead>
        <tbody>
            {% for history in histories %}
                <tr>
                    <td>{{ history.id }}</td>
                    <td>{{ history.archiveEntreprise ? history.archiveEntreprise.id : '' }}</td>
                    <td>{{ history.archiveEtudiant ? history.archiveEtudiant.nomold ~ ' ' ~ history.archiveEtudiant.prenomold : '' }}</td>
                    <td>{{ history.archiveStage ? history.archiveStage.id : '' }}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5">Aucun historique trouvé.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}