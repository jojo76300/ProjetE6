{% extends 'base.html.twig' %}

{% block title %}Modifier le stage - {{ stage.entreprise.nom }}{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mx-auto">
        <!-- Header -->
        <div class="mb-8">
            <a href="{{ path('app_stage_index') }}" class="text-indigo-600 hover:text-indigo-800 font-semibold flex items-center gap-2 mb-6">
                <i class="fas fa-arrow-left"></i>Retour à la liste
            </a>

            <div class="text-center mb-8">
                <h1 class="text-4xl font-bold text-gray-900 mb-2">
                    <i class="fas fa-edit text-indigo-600 mr-3"></i>Modifier le stage
                </h1>
                <p class="text-gray-600">{{ stage.entreprise.nom }}</p>
            </div>
        </div>

        <!-- Form Container -->
        <div class="bg-white rounded-lg shadow-lg p-8 mb-6">
            {{ include('stage/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
        </div>

        <!-- Delete Section -->
        <div class="bg-red-50 rounded-lg shadow-lg p-8 border-t-4 border-red-600">
            <h2 class="text-2xl font-bold text-red-900 mb-4 flex items-center gap-2">
                <i class="fas fa-trash text-red-600"></i>Zone de suppression
            </h2>
            <p class="text-red-700 mb-6">Cette action est irréversible. Toutes les données du stage seront supprimées.</p>
            {{ include('stage/_delete_form.html.twig') }}
        </div>
    </div>
</div>
{% endblock %}
