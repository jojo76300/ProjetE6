{% extends 'base.html.twig' %}

{% block title %}Détail du stage - {{ stage.entreprise.nom }}{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
        <!-- Header -->
        <div class="mb-8">
            <a href="{{ path('app_stage_index') }}" class="text-indigo-600 hover:text-indigo-800 font-semibold flex items-center gap-2 mb-6">
                <i class="fas fa-arrow-left"></i>Retour à la liste
            </a>

            <div class="bg-white rounded-lg shadow-lg p-8 border-t-4 border-indigo-600">
                <h1 class="text-4xl font-bold text-gray-900 mb-4">
                    <i class="fas fa-building text-indigo-600 mr-3"></i>{{ stage.entreprise.nom }}
                </h1>
                <p class="text-gray-600 mb-4">
                    <i class="fas fa-map-marker-alt text-red-500 mr-2"></i>{{ stage.entreprise.adresse }}, {{ stage.entreprise.cp }} {{ stage.entreprise.ville }}
                </p>
            </div>
        </div>

        <!-- Main Content -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Informations principales -->
            <div class="lg:col-span-2 space-y-6">
                <!-- Dates du stage -->
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center gap-2">
                        <i class="fas fa-calendar text-indigo-600"></i>Période du stage
                    </h2>
                    
                    <div class="grid grid-cols-2 gap-6">
                        <div class="border-l-4 border-indigo-600 pl-4">
                            <p class="text-gray-600 text-sm font-semibold uppercase tracking-wider mb-2">Date de début</p>
                            <p class="text-3xl font-bold text-gray-900">
                                {{ stage.dateDebut ? stage.dateDebut|date('d/m/Y') : 'N/A' }}
                            </p>
                            <p class="text-gray-500 text-sm mt-1">
                                {{ stage.dateDebut ? stage.dateDebut|date('l') : '' }}
                            </p>
                        </div>
                        <div class="border-l-4 border-blue-600 pl-4">
                            <p class="text-gray-600 text-sm font-semibold uppercase tracking-wider mb-2">Date de fin</p>
                            <p class="text-3xl font-bold text-gray-900">
                                {{ stage.dateFin ? stage.dateFin|date('d/m/Y') : 'N/A' }}
                            </p>
                            <p class="text-gray-500 text-sm mt-1">
                                {{ stage.dateFin ? stage.dateFin|date('l') : '' }}
                            </p>
                        </div>
                    </div>

                    <!-- Durée -->
                    <div class="mt-6 bg-yellow-50 p-4 rounded-lg border-l-4 border-yellow-600">
                        <p class="text-gray-600 text-sm font-semibold uppercase tracking-wider mb-1">Durée totale</p>
                        <p class="text-2xl font-bold text-yellow-700">
                            {% set duree = (stage.dateFin.timestamp - stage.dateDebut.timestamp) / 86400 %}
                            {{ duree|round }} jours
                        </p>
                    </div>
                </div>

                <!-- Informations entreprise -->
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center gap-2">
                        <i class="fas fa-info-circle text-indigo-600"></i>Informations entreprise
                    </h2>

                    <div class="space-y-4">
                        {% if stage.entreprise.contact %}
                            <div class="flex items-start gap-3">
                                <i class="fas fa-user text-indigo-600 mt-1"></i>
                                <div>
                                    <p class="text-gray-600 text-sm font-semibold uppercase">Contact</p>
                                    <p class="text-gray-900 font-medium">{{ stage.entreprise.contact }}</p>
                                </div>
                            </div>
                        {% endif %}

                        {% if stage.entreprise.tel %}
                            <div class="flex items-start gap-3">
                                <i class="fas fa-phone text-green-600 mt-1"></i>
                                <div>
                                    <p class="text-gray-600 text-sm font-semibold uppercase">Téléphone</p>
                                    <p class="text-gray-900 font-medium">{{ stage.entreprise.tel }}</p>
                                </div>
                            </div>
                        {% endif %}

                        {% if stage.entreprise.email %}
                            <div class="flex items-start gap-3">
                                <i class="fas fa-envelope text-blue-600 mt-1"></i>
                                <div>
                                    <p class="text-gray-600 text-sm font-semibold uppercase">Email</p>
                                    <a href="mailto:{{ stage.entreprise.email }}" class="text-blue-600 hover:text-blue-800 font-medium">
                                        {{ stage.entreprise.email }}
                                    </a>
                                </div>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>

            <!-- Sidebar -->
            <div class="space-y-6">
                <!-- Professeurs -->
                <div class="bg-white rounded-lg shadow-lg p-8">
                    <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center gap-2">
                        <i class="fas fa-chalkboard-user text-indigo-600"></i>Professeurs
                    </h2>

                    <div class="space-y-4">
                        <div class="border-l-4 border-purple-600 pl-4 py-2">
                            <p class="text-gray-600 text-xs font-semibold uppercase mb-1">Professeur suivi</p>
                            <p class="text-gray-900 font-semibold">{{ stage.profSuivi.email }}</p>
                            <div class="mt-2">
                                {% if stage.profSuivi.status %}
                                    <span class="inline-block bg-green-100 text-green-800 px-2 py-1 rounded text-xs font-semibold">
                                        <i class="fas fa-check-circle mr-1"></i>Actif
                                    </span>
                                {% else %}
                                    <span class="inline-block bg-red-100 text-red-800 px-2 py-1 rounded text-xs font-semibold">
                                        <i class="fas fa-times-circle mr-1"></i>Inactif
                                    </span>
                                {% endif %}
                            </div>
                        </div>

                        <div class="border-l-4 border-green-600 pl-4 py-2">
                            <p class="text-gray-600 text-xs font-semibold uppercase mb-1">Professeur visite</p>
                            <p class="text-gray-900 font-semibold">{{ stage.profVisite.email }}</p>
                            <div class="mt-2">
                                {% if stage.profVisite.status %}
                                    <span class="inline-block bg-green-100 text-green-800 px-2 py-1 rounded text-xs font-semibold">
                                        <i class="fas fa-check-circle mr-1"></i>Actif
                                    </span>
                                {% else %}
                                    <span class="inline-block bg-red-100 text-red-800 px-2 py-1 rounded text-xs font-semibold">
                                        <i class="fas fa-times-circle mr-1"></i>Inactif
                                    </span>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Actions -->
                <div class="space-y-3">
                    <a href="{{ path('app_stage_edit', {'id': stage.id}) }}" class="w-full block bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-4 rounded-lg transition-colors duration-200 text-center">
                        <i class="fas fa-edit mr-2"></i>Modifier
                    </a>
                    {{ include('stage/_delete_form.html.twig') }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
