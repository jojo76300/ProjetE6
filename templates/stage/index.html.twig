{% extends 'base.html.twig' %}

{% block title %}Gestion des stages{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
        <!-- Header -->
        <div class="mb-8">
            <h1 class="text-4xl font-bold text-gray-900 mb-2">Gestion des stages</h1>
            <p class="text-gray-600">Gérez les stages et leurs affectations</p>
        </div>

        <!-- Search and Filter Section -->
        <div class="bg-white rounded-lg shadow-md p-6 mb-6">
            <div class="flex items-center justify-between gap-4">
                <div class="flex-1">
                    <div class="relative">
                        <svg class="absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor">
                            <path d="M9 17C13.4183 17 17 13.4183 17 9C17 4.58172 13.4183 1 9 1C4.58172 1 1 4.58172 1 9C1 13.4183 4.58172 17 9 17Z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M19 19L14.65 14.65" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        <input 
                            type="text" 
                            id="searchInput"
                            placeholder="Rechercher un stage..." 
                            class="w-full pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                        />
                    </div>
                </div>
                <a href="{{ path('app_stage_new') }}" class="bg-gray-900 hover:bg-gray-800 text-white font-semibold py-2 px-6 rounded-lg transition-colors duration-200 flex items-center gap-2 whitespace-nowrap">
                    <i class="fas fa-plus"></i>Ajouter un stage
                </a>
            </div>
        </div>

        <!-- Table -->
        <div class="bg-white rounded-lg shadow-md overflow-hidden">
            {% if stages|length > 0 %}
                <table class="w-full">
                    <thead>
                        <tr class="border-b border-gray-200 bg-gray-50">
                            <th class="px-6 py-4 text-left text-sm font-semibold text-gray-900">Étudiant</th>
                            <th class="px-6 py-4 text-left text-sm font-semibold text-gray-900">Entreprise</th>
                            <th class="px-6 py-4 text-left text-sm font-semibold text-gray-900">Période</th>
                            <th class="px-6 py-4 text-left text-sm font-semibold text-gray-900">Prof. Visite</th>
                            <th class="px-6 py-4 text-left text-sm font-semibold text-gray-900">Prof. Suivi</th>
                            <th class="px-6 py-4 text-left text-sm font-semibold text-gray-900">Statut</th>
                            <th class="px-6 py-4 text-left text-sm font-semibold text-gray-900">Commentaire</th>
                            <th class="px-6 py-4 text-left text-sm font-semibold text-gray-900">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for stage in stages %}
                            {# Le isActive et isUpcoming est temporaire le temps de le rajouter dans la base de données #}
                            {% set isUpcoming = stage.dateDebut|date('Y-m-d') > 'now'|date('Y-m-d') %}
                            {% set isActive = stage.dateDebut|date('Y-m-d') <= 'now'|date('Y-m-d') and stage.dateFin|date('Y-m-d') >= 'now'|date('Y-m-d') %}
                            <tr class="border-b border-gray-200 hover:bg-gray-50 transition-colors searchable-row" data-search="{{ stage.entreprise.nom|lower }} {{ stage.profSuivi.email|lower }} {{ stage.dateDebut|date('Y-m-d')|lower }}">
                                <td class="px-6 py-4 text-sm text-gray-900">
                                    <div class="font-medium">{{ stage.etudiant.nom }} {{ stage.etudiant.prenom }}</div>
                                    <div class="text-gray-600 text-xs">{{ stage.etudiant.filiere }}</div>
                                </td>
                                <td class="px-6 py-4 text-sm text-gray-900 font-medium">{{ stage.entreprise.nom }}</td>
                                <td class="px-6 py-4 text-sm text-gray-600">
                                    {{ stage.dateDebut|date('d/m/Y') }} - {{ stage.dateFin|date('d/m/Y') }}
                                </td>
                                <td class="px-6 py-4 text-sm text-gray-900">{{ stage.profVisite.nom }} {{ stage.profVisite.prenom }}</td>
                                <td class="px-6 py-4 text-sm text-gray-900">{{ stage.profSuivi.nom }} {{ stage.profSuivi.prenom }}</td>
                                <td class="px-6 py-4 text-sm">
                                    {% if isUpcoming %}
                                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-orange-100 text-orange-800">
                                            À venir
                                        </span>
                                    {% elseif isActive %}
                                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-blue-100 text-blue-800">
                                            En cours
                                        </span>
                                    {% else %}
                                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-800">
                                            Terminé
                                        </span>
                                    {% endif %}
                                </td>
                                {% if stage.commentaire is empty %}
                                    <td class="px-6 py-4 text-sm text-gray-400 italic">Aucun commentaire</td>
                                {% else %}
                                    <td class="px-6 py-4 text-sm text-gray-900">{{ stage.commentaire }}</td>
                                {% endif %}
                                <td class="px-6 py-4 text-sm">
                                    <div class="flex items-center gap-3">
                                        <a href="{{ path('app_stage_edit', {'id': stage.id}) }}" class="text-blue-600 hover:text-blue-800 transition-colors">
                                            <i class="fas fa-edit text-lg"></i>
                                        </a>
                                        <form method="post" action="{{ path('app_stage_delete', {'id': stage.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer le stage de {{ stage.etudiant.prenom }} {{ stage.etudiant.nom }} chez {{ stage.entreprise.nom|escape('js') }} ? Cette action est irréversible.');" class="inline-block">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ stage.id) }}">
                                            <button type="submit" class="text-red-600 hover:text-red-800 transition-colors">
                                                <i class="fas fa-trash text-lg"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% else %}
                <div class="p-12 text-center">
                    <i class="fas fa-inbox text-gray-400 text-6xl mb-4 block"></i>
                    <h3 class="text-lg font-semibold text-gray-900 mb-2">Aucun stage trouvé</h3>
                    <p class="text-gray-600 mb-6">Commencez par ajouter un stage</p>
                    <a href="{{ path('app_stage_new') }}" class="inline-block bg-gray-900 hover:bg-gray-800 text-white font-semibold py-2 px-6 rounded-lg transition-colors">
                        <i class="fas fa-plus mr-2"></i>Ajouter un stage
                    </a>
                </div>
            {% endif %}
        </div>
    </div>
</div>

<script>
document.getElementById('searchInput').addEventListener('keyup', function() {
    const searchTerm = this.value.toLowerCase();
    const rows = document.querySelectorAll('.searchable-row');
    
    rows.forEach(row => {
        const searchData = row.getAttribute('data-search');
        if (searchData.includes(searchTerm)) {
            row.style.display = '';
        } else {
            row.style.display = 'none';
        }
    });
});
</script>
{% endblock %}
